@model IEnumerable<ExamenBiblioteca.Models.Libro>

<h2>Listado de Libros</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">@ViewBag.Mensaje</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<p>
    <a asp-action="Crear" class="btn btn-primary">Registrar Nuevo Libro</a>
    <a asp-action="BuscarPorAutor" class="btn btn-info">Buscar por Autor</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre del Libro</th>
            <th>Autor</th>
            <th>Editorial</th>
            <th>ISBN</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.NombreLibro</td>
                <td>@item.Autor</td>
                <td>@item.NombreEditorial</td>
                <td>@item.ISBN</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>

                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" style="display:inline;"
                          onsubmit="return confirm('¿Está seguro de que desea eliminar este libro?');">
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>